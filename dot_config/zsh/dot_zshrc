# check what apps are not managed by homebrew

brewoutcasts() {
  local count=0
  local total=0

  for app in /Applications/*.app; do
    [[ -d "$app" ]] || continue
    ((total++))
    name=$(basename "$app" .app)

    # Normalize app name for Homebrew comparison
    local name_normalized="${name:l}"
    name_normalized="${name_normalized// /-}"
    name_normalized="${name_normalized//./-}"

    # Handle specific app name mappings
    case "$name" in
      "Hidden Bar") name_normalized="hiddenbar" ;;
      "Helium") name_normalized="helium-browser" ;;
      "Safari") continue ;;
    esac

    if ! brew list --formula | grep -iq "^${name_normalized}$" && \
       ! brew list --cask | grep -iq "^${name_normalized}$"; then
      echo "$name is NOT managed by Homebrew"
      ((count++))
    fi
  done

  echo ""
  echo "Summary: $count out of $total applications are not managed by Homebrew"
}

# yazi
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

